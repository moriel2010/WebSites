<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage1.master.cs" Inherits="MasterPage1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>+שירים</title>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>

    <style>
        img.main {
            width: 120px;
            height: 80px;
        }

        .menu img {
            width: 120px;
            height: 80px;
            object-fit: contain;
        }

        .menu a {
            display: inline-block;
            margin: 5px;
            vertical-align: middle;
        }

        input, textarea, select {
            font-size: 18px;
        }
    </style>
</head>

<body>
    שלום <% = Session["userName"] %>

    <center>
       <table border="1" style="width: 100%; height: 100vh; background: linear-gradient(135deg, #1a1a1a, #4a148c, #d4af37);">
            <tr style="height: 70px">
                <td style="text-align: center">
                   <span style="font-size: 50px; font-weight: bold; background: linear-gradient(to right, black, purple, gold); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
    +שירים
</span>
                </td>
            </tr>

            <tr height="150px">
                <td class="menu" style="text-align: center">
                    <a href="HomePage.aspx"><img src="Image/HomePage.png" class="main" /></a>
                    <a href="Kefel.aspx">כפל</a>
                    <a href="enrollmentPage.aspx"><img src="Image/enrollmentPage.png" class="main" /></a>
                    <a href="galleryPage.aspx"><img src="Image/galleryPage.png" class="main" /></a>
                    <a href="entryPage.aspx"><img src="Image/entryPage.png" class="main" /></a>
                    <a href="informionPage.aspx"><img src="Image/informion.png" class="main" /></a>
                    <a href="managementPage.aspx"><img src="Image/managementPage.png" class="main" /></a>
                    <a href="odotPage.aspx"><img src="Image/odotPage.png"  class="main" /></a>
                    <a href="AddPage.aspx"><img src="Image/AddPage.png"  class="main" /></a>
                    <a href="exitPage.aspx"><img src="Image/exitPage.png" class="main" /></a>
                    <a href="UpdateDetailsPage.aspx"><img src="Image/UpdateDetailsPage.png" class="main" /></a>
                </td>
            </tr>

            <tr>
                <td style="text-align: center">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </td>
            </tr>
        </table>
    </center>
</body>
</html>